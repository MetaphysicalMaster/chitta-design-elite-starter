{
  "name": "chitta-design-elite-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Elite UI/UX Engineer starter — Next.js 16 + Tailwind v4 + Framer Motion + shadcn/ui + Aceternity UI + Magic UI + Geist. $10K-quality bar enforced via DesignGod skill.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lighthouse": "npx --yes lighthouse http://localhost:3000 --preset=desktop --output=html --output-path=./.quality/lighthouse-desktop.html --chrome-flags=\"--headless\" --quiet",
    "lighthouse:mobile": "npx --yes lighthouse http://localhost:3000 --output=html --output-path=./.quality/lighthouse-mobile.html --chrome-flags=\"--headless\" --quiet",
    "axe": "npx --yes @axe-core/cli http://localhost:3000 --tags wcag2a,wcag2aa,wcag22aa,best-practice --save ./.quality/axe.json",
    "analyze": "ANALYZE=true next build",
    "quality": "pnpm lighthouse && pnpm lighthouse:mobile && pnpm axe",
    "clean": "rm -rf .next .quality node_modules"
  },
  "dependencies": {
    "@builder.io/partytown": "^0.10.3",
    "@floating-ui/react": "^0.27.19",
    "@formkit/auto-animate": "^0.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@rive-app/react-canvas": "^4.28.3",
    "@shadergradient/react": "^2.4.20",
    "@studio-freight/hamo": "^0.6.33",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "konva": "^10.3.0",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.1",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "paper": "^0.12.18",
    "postprocessing": "^6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.4",
    "react-spring": "^10.0.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tsparticles": "^3.9.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "leva": "^0.10.1",
    "r3f-perf": "^7.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
